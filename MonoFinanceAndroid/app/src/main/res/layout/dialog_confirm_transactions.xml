<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Перевірка витрат"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_dictated_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="16dp"
        android:maxLines="3"
        android:ellipsize="end" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="100dp"
        android:maxHeight="300dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/ll_dialog_items_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_secondary_bg"
            android:text="Скасувати"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="16dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_submit"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/btn_accent_bg"
            android:text="Надіслати"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:paddingHorizontal="20dp" />

    </LinearLayout>

</LinearLayout>
